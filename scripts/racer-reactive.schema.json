{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "direction": {
            "type": "string",
            "enum": [
              "up",
              "down",
              "left",
              "right",
              "up+left",
              "up+right",
              "down+left",
              "down+right",
              "none"
            ]
          },
          "frames": {
            "type": "integer",
            "const": 12
          }
        },
        "required": [
          "direction",
          "frames"
        ],
        "additionalProperties": false
      },
      "maxItems": 1
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "plan",
    "note"
  ],
  "additionalProperties": false
}
